{
  "name": "@libs/semantic-ui-react",
  "version": "3.0.0-beta.2-vn7",
  "description": "The official Semantic-UI-React integration.",
  "publishConfig": {
    "registry": "http://nexus.dev.videonext.net:8081/repository/npm-hosted/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/es/*.d.ts",
        "default": "./dist/es/*.js"
      },
      "require": {
        "types": "./dist/commonjs/*.d.ts",
        "default": "./dist/commonjs/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/umd/semantic-ui-react.min.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "cross-env NODE_ENV=production gulp build",
    "build:docs": "cross-env NODE_ENV=production gulp build:docs",
    "build:docs:staging": "cross-env STAGING=true yarn build:docs && yarn serve docs/dist",
    "build:dist": "gulp build:dist",
    "prebuild:size": "gulp build:dist:es",
    "build:size": "node bundle-size/bundle.js",
    "check:has-valid-typings": "node check-has-valid-typings.mjs",
    "check:typings": "yarn tsd:test && yarn test",
    "ci": "yarn tsd:test && yarn lint && yarn test",
    "predeploy:docs": "cross-env NODE_ENV=production yarn build:docs && gulp build:docs:cname",
    "deploy:docs": "gulp deploy:docs",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false NODE_ENV=production eslint . --ext .js,.ts,.tsx",
    "lint:fix": "yarn lint --fix",
    "prettier": "prettier --list-different \"**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "prerelease": "yarn lint && yarn tsd:test && yarn test && cross-env NODE_ENV=production yarn build",
    "postrelease": "yarn deploy:docs",
    "release": "release-it",
    "prestart": "yarn satisfied --fix yarn",
    "start": "cross-env NODE_ENV=development gulp --series start:docs",
    "satisfied": "satisfied --ignore \"webpack|react|react-dom\" --skip-invalid",
    "pretest": "yarn satisfied && gulp build:docs:docgen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:umd": "gulp build:dist:umd && node test/umd.js",
    "tsd:test": "gulp build:dist:commonjs:tsd && tsc -p ./ --noEmit"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "post-commit": "git update-index --again"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --fix"
    ],
    "**/*.mdx": [
      "prettier --parser mdx --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://github.com/Semantic-Org/Semantic-UI-React.git"
  },
  "author": "Levi Thomason <me@levithomason.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Semantic-Org/Semantic-UI-React/issues"
  },
  "homepage": "https://github.com/Semantic-Org/Semantic-UI-React#readme",
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@fluentui/react-component-event-listener": "~0.63.0",
    "@popperjs/core": "^2.11.8",
    "@semantic-ui-react/event-stack": "^3.1.3",
    "clsx": "^2.1.1",
    "keyboard-key": "^1.1.0",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "prop-types": "^15.8.1",
    "react-popper": "^2.3.0",
    "shallowequal": "^1.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-export-default-from": "^7.29.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/register": "^7.29.7",
    "@babel/standalone": "^7.29.7",
    "@mdx-js/loader": "^0.20.3",
    "@percy/cli": "^1.0.0-beta.73",
    "@percy/cypress": "^3.1.1",
    "@size-limit/file": "^4.5.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.7.0",
    "anchor-js": "^4.2.2",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^8.4.1",
    "babel-plugin-filter-imports": "^4.0.0",
    "babel-plugin-istanbul": "^6.1.1",
    "babel-plugin-lodash": "^3.3.4",
    "babel-plugin-transform-next-use-client": "^1.1.1",
    "babel-plugin-transform-react-handled-props": "^2.1.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "babel-plugin-transform-rename-import": "^2.3.0",
    "babel-plugin-universal-import": "^2.0.2",
    "chai": "^4.2.0",
    "copy-to-clipboard": "^3.3.3",
    "cross-env": "^7.0.3",
    "cypress": "^5.4.0",
    "debug": "^4.1.1",
    "dirty-chai": "^2.0.1",
    "doctoc": "^1.4.0",
    "doctrine": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-cypress": "^2.15.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mocha": "^7.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "faker": "^4.1.0",
    "gh-pages": "^3.2.3",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-load-plugins": "^2.0.8",
    "gulp-util": "^3.0.8",
    "husky": "^4.2.5",
    "jsdom": "^29.1.1",
    "leven": "^3.1.0",
    "lint-staged": "^10.2.11",
    "prettier": "^2.8.8",
    "prismjs": "^1.20.0",
    "puppeteer": "^13.0.1",
    "react": "^19.2.6",
    "react-ace": "^6.4.0",
    "react-codesandboxer": "^3.1.3",
    "react-docgen": "^7.0.1",
    "react-dom": "^19.2.6",
    "react-hot-loader": "^4.13.1",
    "react-intersection-observer": "^8.34.0",
    "react-is": "^19.2.6",
    "react-router": "^5.0.0",
    "react-router-dom": "^5.0.0",
    "react-source-render": "^3.0.0-5",
    "react-static": "^5.9.7",
    "react-static-routes": "^1.0.0",
    "react-test-renderer": "^19.0.0",
    "react-universal-component": "^3.0.3",
    "release-it": "^15.5.1",
    "rimraf": "^3.0.2",
    "satisfied": "^1.1.2",
    "semantic-ui-css": "^2.5.0",
    "simulant": "^0.2.2",
    "sinon": "^9.0.2",
    "sinon-chai": "^3.5.0",
    "size-limit": "^4.5.5",
    "start-server-and-test": "^1.11.5",
    "terser-webpack-plugin": "^3.0.8",
    "terser-webpack-plugin-legacy": "^1.2.3",
    "through2": "^3.0.1",
    "typescript": "^5.9.3",
    "vinyl": "^2.2.0",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "changelog": {
    "repo": "Semantic-Org/Semantic-UI-React",
    "cacheDir": ".changelog",
    "labels": {
      "PR: Breaking Change :boom:": ":boom: Breaking Change",
      "PR: New Feature :rocket:": ":rocket: New Feature",
      "PR: Bug Fix :bug:": ":bug: Bug Fix",
      "PR: Docs :memo:": ":memo: Documentation",
      "PR: Internal :house:": ":house: Internal",
      "PR: Performance :running_woman:": ":running_woman: Performance"
    }
  },
  "packageManager": "yarn@4.15.0",
  "overrides": {
    "ajv": "^6.12.4"
  }
}
